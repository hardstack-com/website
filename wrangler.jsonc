{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hardstack-website",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "hardstack.com", "custom_domain": true },
    { "pattern": "www.hardstack.com", "custom_domain": true }
  ]
}
